{
    "id": "moscow",
    "bbbike_name": "Moscow",
    "feed_ids": [
        // Mobility Database mirror (mdb-3226) of the data.mos.ru Mosgortrans surface-transport GTFS.
        // The busmaps.com mirror used before went behind a paywall (404) in Aug 2026. Buses + trams
        // only; no Moscow Metro / MCC / MCD GTFS exists anywhere (the old feed had none either) and
        // no shapes.txt. Frozen snapshot dated 2025-05-27 (MDB marks the upstream inactive); a fresh
        // feed would have to be assembled from data.mos.ru datasets 60661-60666 via apidata.mos.ru,
        // which needs a registered api_key. Transitland has no Moscow feeds at all.
        "https://files.mobilitydatabase.org/mdb-3226/latest.zip"
    ],
    "name": "Moscow, Russia",
    "file": "moscow.bin",
    "bbox": "37.3220,55.5660,37.8810,55.9160",
    "center": [
        55.75,
        37.61
    ],
    "zoom": 12,
    "detail": "Mosgortrans buses and trams (no Metro GTFS available)",
    "tags": [
        "russia",
        "bus",
        "tram"
    ],
    // No feed_info dates, so the auto stale policy would extend the ~900 services that ended in
    // 2025/2026 and revive discontinued routes. Active services run to 2030-12-31, so honor dates.
    "allow_stale": false,
    "disabled": true
}
