{
    "id": "madrid",
    "bbbike_name": "Madrid",
    "feed_ids": [
        // busmaps.com mirrors went behind a paywall in Aug 2026; these are the publishers' own feeds.
        // Spain's NAP (nap.transportes.gob.es) needs an API key, so CRTM feeds are taken from CRTM's
        // ArcGIS items (their upstream; same bytes as Transitland f-ezjm-*). ArcGIS sends no
        // ETag/Last-Modified, so those two are re-downloaded (and hash-checked) every run.
        // Do NOT add f-ezj-informaciónoficial~… or f-autobús~urbano~de~madrid: both are EMT duplicates.
        "https://servicios.emtmadrid.es:8443/gtfs/transitemt.zip", // EMT Madrid (official, updated daily)
        "https://api.control.optibus.co/opendata/v1/gtfs?uid=c-5cfcd2d1", // EMT Fuenlabrada (Optibus open data; uid is a fixed customer id; ~15-day rolling calendar)
        "https://www.arcgis.com/sharing/rest/content/items/aaed26cc0ff64b0c947ac0bc3e033196/data", // CRTM "GTFS Red de Metro Ligero" (ML1-ML4)
        "https://www.arcgis.com/sharing/rest/content/items/5c7f2951962540d69ffe8f640d94c246/data" // CRTM "GTFS Red de Metro"; last published 2025-05-30, calendar ended 2026-05-27 (stale policy extends it). No fresher Metro de Madrid GTFS exists anywhere.
    ],
    "name": "Madrid, Spain",
    "file": "madrid.bin",
    "bbox": "-4.0700,40.1700,-3.2300,40.6500",
    "center": [
        40.410,
        -3.650
    ],
    "zoom": 12,
    "detail": "Metro de Madrid, EMT, Metro Ligero",
    "tags": [
        "spain",
        "subway",
        "rail",
        "bus"
    ]
}
